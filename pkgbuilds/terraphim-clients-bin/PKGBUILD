# Maintainer: Terraphim Team <team@terraphim.ai>
# Contributor: Alex Mikhalev <alex@metacortex.engineer>
#
# Canonical split PKGBUILD for the prebuilt Terraphim AI client CLIs.
#
# This file is the single upstream source of truth for the AUR package
# `terraphim-clients-bin` (Gitea terraphim-clients#316). The downstream
# Omarchy directory
# `omacom/omarchy-pkgs/pkgbuilds/terraphim-clients-bin/` consumes the same
# split-package semantics (Gitea terraphim-clients#249).
#
# The release archives are self-contained (binary + both license texts) and
# are static-PIE linked, so nothing is compiled and neither output has a
# runtime library dependency.
#
# Regenerate the committed .SRCINFO after any edit; ./verify.sh fails on
# drift. See README.md for the container/CI invocation.

pkgbase=terraphim-clients-bin
pkgname=(terraphim-agent-bin terraphim-grep-bin)
pkgver=1.21.21
pkgrel=1
pkgdesc='Terraphim AI command-line clients (prebuilt static MUSL binaries)'
arch=('x86_64' 'aarch64')
url='https://terraphim.ai'
license=('Apache-2.0' 'MIT')
options=('!strip' '!debug')

_repo='terraphim/terraphim-clients'
_release="https://github.com/${_repo}/releases/download/v${pkgver}"

# One archive per binary per architecture. Every archive extracts the CLI plus
# the repository's two license texts (identical bytes in both archives, so the
# colliding extraction is harmless).
source_x86_64=(
  "terraphim-agent-${pkgver}-x86_64-unknown-linux-musl.tar.gz::${_release}/terraphim-agent-${pkgver}-x86_64-unknown-linux-musl.tar.gz"
  "terraphim-grep-${pkgver}-x86_64-unknown-linux-musl.tar.gz::${_release}/terraphim-grep-${pkgver}-x86_64-unknown-linux-musl.tar.gz"
)
source_aarch64=(
  "terraphim-agent-${pkgver}-aarch64-unknown-linux-musl.tar.gz::${_release}/terraphim-agent-${pkgver}-aarch64-unknown-linux-musl.tar.gz"
  "terraphim-grep-${pkgver}-aarch64-unknown-linux-musl.tar.gz::${_release}/terraphim-grep-${pkgver}-aarch64-unknown-linux-musl.tar.gz"
)

# Digests are the authoritative SHA-256 values published in the release's
# SHA256SUMS asset for v${pkgver}. tests/test_pkgbuild_release_contract.py pins
# the same values so a version bump cannot silently keep stale digests.
sha256sums_x86_64=(
  '3520f60adebbf5ae79f386144550222f695567509a6da641e8c87b688bb901a1'
  'bd0bf89c0d2806195f7dca3dc4cf9bc883744599ff5c927950993a52c4a129fe'
)
sha256sums_aarch64=(
  'b8637ec876f272322dcb8ded38311b7f8c6156af0f5a41c2de991eda190a8ba0'
  'b3902c6127b4ac3c67c7c09a6e724c9c42f80af48da998fbc172d7f86ac9f2bc'
)

# Prebuilt, already-stripped static binaries: never strip or emit debug info.
# `depends` is intentionally left unset (empty) for both outputs: the MUSL
# binaries are static-PIE and pull in no runtime libraries.
# `arch`, `source*` and `sha256sums*` are shared by both split outputs.

package_terraphim-agent-bin() {
  pkgdesc='Terraphim AI agent CLI (prebuilt static MUSL binary)'
  license=('Apache-2.0')
  provides=('terraphim-agent')
  conflicts=('terraphim-agent')

  install -Dm0755 "${srcdir}/terraphim-agent" \
    "${pkgdir}/usr/bin/terraphim-agent"
  install -Dm0644 "${srcdir}/LICENSE-Apache-2.0" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-Apache-2.0"
  install -d "${pkgdir}/usr/share/terraphim/package-manager.d"
  printf 'pacman\n' > "${pkgdir}/usr/share/terraphim/package-manager.d/terraphim-agent"
}

package_terraphim-grep-bin() {
  pkgdesc='Terraphim AI grep CLI (prebuilt static MUSL binary)'
  license=('MIT')
  provides=('terraphim-grep')
  conflicts=('terraphim-grep')

  install -Dm0755 "${srcdir}/terraphim-grep" \
    "${pkgdir}/usr/bin/terraphim-grep"
  install -Dm0644 "${srcdir}/LICENSE-MIT" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -d "${pkgdir}/usr/share/terraphim/package-manager.d"
  printf 'pacman\n' > "${pkgdir}/usr/share/terraphim/package-manager.d/terraphim-grep"
}
